    property = displacement_jump_normal
    variable = jump_normal_aux
    boundary = 'Block100_Block200 Block300_Block400 Block500_Block600 Block700_Block800 Block900_Block1000'
    execute_on = 'TIMESTEP_END'
  []
  [get_jump_strike_rate]
